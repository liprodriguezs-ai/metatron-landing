---
import { Image } from 'astro:assets';
import { otherSpecialties, services } from '../data/site';
import electrica from '../assets/img/electrica.jpg';
import solar from '../assets/img/solar.jpg';
import hvac from '../assets/img/hvac.jpg';
import aislamiento from '../assets/img/aislamiento.jpg';
import civil from '../assets/img/civil.jpg';
import estructural from '../assets/img/estructural.jpg';

const images = { electrica, solar, hvac, aislamiento, civil, estructural };
---

<section class="svc section" id="servicios" aria-labelledby="svc-title">
  <div class="wrap">
    <header class="section-head svc__head">
      <p class="eyebrow" data-reveal>Especialidades</p>
      <h2 id="svc-title" data-reveal style="--d:.08s">
        Seis disciplinas, <br /><span class="accent">una sola responsabilidad.</span>
      </h2>
      <p class="svc__intro" data-reveal style="--d:.16s">
        Mantenimiento, reparación y puesta en operación con personal calificado y equipo especializado,
        en plataformas costa afuera y en instalaciones terrestres.
      </p>
    </header>

    <div class="svc__grid">
      <div class="svc__media" aria-hidden="true">
        <div class="svc__frame">
          {
            services.map((s, i) => (
              <Image
                src={images[s.image]}
                alt=""
                widths={[640, 960, 1280]}
                sizes="(max-width: 900px) 100vw, 45vw"
                class:list={['svc__img', { 'is-on': i === 0 }]}
                data-img={s.id}
                loading={i === 0 ? 'eager' : 'lazy'}
                format="avif"
                quality={64}
              />
            ))
          }
          <div class="svc__tag mono"><span data-svc-idx>01</span> / 06</div>
        </div>
      </div>

      <ol class="svc__list" role="list">
        {
          services.map((s) => (
            <li>
              <article class="card" id={s.id} data-svc={s.id} aria-labelledby={`${s.id}-t`}>
                <Image
                  src={images[s.image]}
                  alt={s.alt}
                  widths={[480, 800]}
                  sizes="100vw"
                  class="card__img"
                  format="avif"
                  quality={60}
                />
                <div class="card__top">
                  <span class="card__idx mono">{s.index}</span>
                  <span class="card__where mono">Offshore · Terrestre</span>
                </div>
                <h3 id={`${s.id}-t`} class="card__title">{s.name}</h3>
                <p class="card__sum">{s.summary}</p>
                <ul class="card__scope" role="list">
                  {s.scope.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            </li>
          ))
        }
      </ol>
    </div>

    <aside class="svc__more" aria-label="Otras especialidades" data-reveal>
      <span class="mono">También atendemos</span>
      <ul role="list">
        {otherSpecialties.map((o) => <li>{o}</li>)}
      </ul>
    </aside>
  </div>
</section>

<style>
  .svc__head {
    grid-template-columns: 1fr 1fr;
    align-items: end;
  }
  .svc__head .eyebrow {
    grid-column: 1 / -1;
  }
  .svc__intro {
    color: var(--fg-muted);
    max-width: 30rem;
    justify-self: end;
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .svc__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 7rem);
  }
  .svc__media {
    position: sticky;
    top: 6.5rem;
    height: calc(100vh - 9rem);
    height: calc(100svh - 9rem);
    min-height: 26rem;
  }
  .svc__frame {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--navy-900);
  }
  .svc__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.08);
    transition:
      opacity 1s var(--ease-out),
      transform 1.6s var(--ease-out);
  }
  .svc__img.is-on {
    opacity: 1;
    transform: scale(1);
  }
  .svc__tag {
    position: absolute;
    left: 1.25rem;
    bottom: 1.25rem;
    padding: 0.5rem 0.75rem;
    background: rgb(6 14 32 / 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .svc__tag span {
    color: var(--gold-400);
  }

  .svc__list > li + li {
    border-top: 1px solid var(--line);
  }
  .card {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(3rem, 9vh, 6rem);
    min-height: 70vh;
    align-content: center;
    scroll-margin-top: 5rem;
  }
  .card__img {
    display: none;
  }
  .card__top {
    display: flex;
    justify-content: space-between;
    color: var(--fg-dim);
  }
  .card__idx {
    color: var(--gold-400);
  }
  .card__title {
    font-size: var(--step-3);
    font-weight: 300;
  }
  .card__sum {
    color: var(--fg-muted);
    font-size: var(--step-1);
    line-height: 1.45;
    max-width: 32rem;
  }
  .card__scope {
    display: grid;
    margin-top: 0.75rem;
    border-top: 1px solid var(--line);
  }
  .card__scope li {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.98rem;
  }
  .card__scope li::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    transform: translateY(-2px) rotate(45deg);
    background: var(--gold-500);
  }

  .svc__more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .svc__more .mono {
    color: var(--gold-400);
  }
  .svc__more ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    color: var(--fg-muted);
  }

  @media (max-width: 900px) {
    .svc__head {
      grid-template-columns: 1fr;
    }
    .svc__intro {
      justify-self: start;
    }
    .svc__grid {
      grid-template-columns: 1fr;
    }
    .svc__media {
      display: none;
    }
    .card {
      min-height: 0;
      padding-block: 2.5rem;
    }
    .card__img {
      display: block;
      width: 100%;
      aspect-ratio: 3 / 2;
      height: auto;
      object-fit: cover;
      border-radius: var(--radius);
      margin-bottom: 0.5rem;
    }
  }
</style>

<script>
  const imgs = [...document.querySelectorAll<HTMLElement>('[data-img]')];
  const idx = document.querySelector<HTMLElement>('[data-svc-idx]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-svc]')];
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const id = (e.target as HTMLElement).dataset.svc;
        imgs.forEach((im) => im.classList.toggle('is-on', im.dataset.img === id));
        if (idx) idx.textContent = String(cards.indexOf(e.target as HTMLElement) + 1).padStart(2, '0');
      }
    },
    { rootMargin: '-45% 0px -45% 0px' },
  );
  cards.forEach((c) => io.observe(c));
</script>
