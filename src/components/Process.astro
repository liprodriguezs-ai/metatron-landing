---
import { Image } from 'astro:assets';
import blueprint from '../assets/img/blueprint.jpg';
import { process } from '../data/site';
---

<section class="proc section" id="proceso" aria-labelledby="proc-title">
  <Image
    src={blueprint}
    alt=""
    aria-hidden="true"
    widths={[960, 1600, 2400]}
    sizes="100vw"
    class="proc__bg"
    format="avif"
    quality={55}
  />
  <div class="proc__veil" aria-hidden="true"></div>
  <div class="wrap proc__in">
    <header class="section-head">
      <p class="eyebrow" data-reveal>Proceso</p>
      <h2 id="proc-title" data-reveal style="--d:.08s">
        De la planeación <br /><span class="accent">a la puesta en operación.</span>
      </h2>
    </header>

    <ol class="steps" role="list" data-steps>
      <span class="steps__line" aria-hidden="true"><i data-steps-line></i></span>
      {
        process.map((p, i) => (
          <li class="step" data-reveal style={`--d:${i * 0.1}s`}>
            <span class="step__dot" aria-hidden="true" />
            <span class="step__n mono">Etapa {p.step}</span>
            <h3 class="step__t">{p.title}</h3>
            <p class="step__p">{p.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .proc {
    overflow: hidden;
    background: var(--navy-900);
  }
  .proc__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    opacity: 0.55;
  }
  .proc__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, var(--navy-950) 0%, rgb(10 22 48 / 0.6) 25%, rgb(10 22 48 / 0.6) 75%, var(--navy-950) 100%);
  }
  .proc__in {
    position: relative;
  }
  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .steps__line {
    position: absolute;
    left: 0;
    right: 0;
    top: 6px;
    height: 1px;
    background: var(--line-strong);
  }
  .steps__line i {
    position: absolute;
    inset: 0;
    background: var(--gold-400);
    transform-origin: left;
    transform: scaleX(var(--p, 0));
  }
  .step {
    position: relative;
    display: grid;
    gap: 0.9rem;
    align-content: start;
    padding-top: 2.5rem;
  }
  .step__dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 13px;
    height: 13px;
    border: 1px solid var(--gold-400);
    background: var(--navy-950);
    transform: rotate(45deg);
  }
  .step__n {
    color: var(--gold-400);
  }
  .step__t {
    font-size: var(--step-2);
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  .step__p {
    color: var(--fg-muted);
  }
  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 0;
      padding-left: 2rem;
    }
    .steps__line {
      left: 6px;
      right: auto;
      top: 0;
      bottom: 0;
      width: 1px;
      height: auto;
    }
    .steps__line i {
      transform-origin: top;
      transform: scaleY(var(--p, 0));
    }
    .step {
      padding: 0 0 2.75rem;
    }
    .step__dot {
      left: calc(-2rem);
      top: 0.35rem;
    }
  }
</style>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-steps]');
  const line = document.querySelector<HTMLElement>('[data-steps-line]');
  if (wrap && line) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) line.style.setProperty('--p', '1');
    else {
      const onScroll = () => {
        const r = wrap.getBoundingClientRect();
        const vh = window.innerHeight;
        const p = Math.min(1, Math.max(0, (vh * 0.8 - r.top) / (r.height + vh * 0.2)));
        line.style.setProperty('--p', p.toFixed(3));
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
  }
</script>
