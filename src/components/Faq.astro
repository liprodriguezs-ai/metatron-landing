---
import { faqs } from '../data/site';
---

<section class="faq section" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq__grid">
    <header class="faq__head">
      <p class="eyebrow" data-reveal>Preguntas frecuentes</p>
      <h2 id="faq-title" data-reveal style="--d:.08s">
        Lo que nos <span class="accent">preguntan.</span>
      </h2>
      <p class="faq__note" data-reveal style="--d:.16s">
        ¿No encuentras tu respuesta? Escríbenos con el alcance de tu proyecto y te respondemos con una
        propuesta técnica.
      </p>
    </header>

    <div class="faq__list">
      {
        faqs.map((f, i) => (
          <details class="qa" name="faq" open={i === 0} data-reveal style={`--d:${i * 0.04}s`}>
            <summary>
              <span class="mono qa__n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="qa__q">{f.q}</h3>
              <span class="qa__icon" aria-hidden="true" />
            </summary>
            <div class="qa__a">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 6vw, 7rem);
    align-items: start;
  }
  .faq__head {
    position: sticky;
    top: 7rem;
    display: grid;
    gap: 1.5rem;
  }
  .faq__head h2 {
    font-size: min(var(--step-4), 5rem);
    max-width: 7em;
  }
  .faq__note {
    color: var(--fg-muted);
    max-width: 24rem;
  }
  .faq__list {
    border-top: 1px solid var(--line);
  }
  .qa {
    border-bottom: 1px solid var(--line);
  }
  .qa summary {
    display: grid;
    grid-template-columns: 2.75rem 1fr 1.5rem;
    gap: 1rem;
    align-items: center;
    padding-block: 1.6rem;
    cursor: pointer;
    list-style: none;
  }
  .qa summary::-webkit-details-marker {
    display: none;
  }
  .qa__n {
    color: var(--gold-400);
  }
  .qa__q {
    font-size: var(--step-1);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.3;
    transition: color 0.3s;
  }
  .qa summary:hover .qa__q {
    color: var(--gold-200);
  }
  .qa__icon {
    position: relative;
    width: 1.5rem;
    height: 1.5rem;
  }
  .qa__icon::before,
  .qa__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 1.5px;
    margin: -0.75px 0 0 -7px;
    background: var(--paper);
    transition: transform 0.5s var(--ease-out);
  }
  .qa__icon::after {
    transform: rotate(90deg);
  }
  .qa[open] .qa__icon::after {
    transform: rotate(0);
  }
  .qa__a {
    padding: 0 2.5rem 1.75rem 3.75rem;
    color: var(--fg-muted);
    max-width: 48rem;
  }
  .qa::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.5s var(--ease-out),
      content-visibility 0.5s allow-discrete;
  }
  .qa[open]::details-content {
    block-size: auto;
  }
  @supports (interpolate-size: allow-keywords) {
    :root {
      interpolate-size: allow-keywords;
    }
  }
  @media (max-width: 900px) {
    .faq__grid {
      grid-template-columns: 1fr;
    }
    .faq__head {
      position: static;
    }
    .qa summary {
      grid-template-columns: 2.25rem 1fr 1.25rem;
    }
    .qa__a {
      padding: 0 0 1.5rem 3.25rem;
    }
  }
</style>
