---
import { getImage } from 'astro:assets';
import frameDesktop from '../assets/img/frame-inicio.jpg';
import frameMobile from '../assets/img/frame-inicio-movil.jpg';
import { services, site, whatsappUrl } from '../data/site';

const wide = await Promise.all(
  [1280, 1920, 2560, 3840].map((width) => getImage({ src: frameDesktop, width, format: 'avif', quality: 62 })),
);
const tall = await Promise.all(
  [720, 1080].map((width) => getImage({ src: frameMobile, width, format: 'avif', quality: 56 })),
);
const fallback = await getImage({ src: frameDesktop, width: 1920, format: 'jpg', quality: 80 });
const srcset = (imgs: { src: string; options: { width?: number } }[]) =>
  imgs.map((i) => `${i.src} ${i.options.width}w`).join(', ');

// Scroll-scrubbed hero video, best codec first. Tiers are picked by the device pixels the
// cover-fitted video needs; the 9:16 cut serves portrait screens.
const videoSources = {
  wide: [
    { w: 2560, src: '/media/hero-2560-av1.mp4', type: 'video/mp4; codecs="av01.0.12M.10"' },
    { w: 2560, src: '/media/hero-2560-hevc.mp4', type: 'video/mp4; codecs="hvc1.2.4.L150.B0"' },
    { w: 1920, src: '/media/hero-1920-av1.mp4', type: 'video/mp4; codecs="av01.0.08M.10"' },
    { w: 1920, src: '/media/hero-1920-hevc.mp4', type: 'video/mp4; codecs="hvc1.2.4.L123.B0"' },
    { w: 1920, src: '/media/hero-1920.mp4', type: 'video/mp4; codecs="avc1.640028"' },
  ],
  tall: [
    { w: 1080, src: '/media/hero-movil-av1.mp4', type: 'video/mp4; codecs="av01.0.08M.10"' },
    { w: 1080, src: '/media/hero-movil-hevc.mp4', type: 'video/mp4; codecs="hvc1.2.4.L123.B0"' },
    { w: 1080, src: '/media/hero-movil.mp4', type: 'video/mp4; codecs="avc1.640028"' },
  ],
};
---

<section class="hero" id="inicio" data-hero aria-labelledby="hero-title">
  <div class="hero__sticky">
    <div class="hero__media" aria-hidden="true">
      <picture>
        <source
          media="(max-aspect-ratio: 4/5)"
          srcset={srcset(tall)}
          sizes="max(100vw, 56.25vh)"
          type="image/avif"
        />
        <source srcset={srcset(wide)} sizes="max(100vw, 177.78vh)" type="image/avif" />
        <img
          class="hero__poster"
          src={fallback.src}
          width="1920"
          height="1080"
          alt=""
          decoding="async"
        />
      </picture>
      <video
        class="hero__video"
        muted
        playsinline
        preload="none"
        disablepictureinpicture
        tabindex="-1"
        data-sources={JSON.stringify(videoSources)}
      ></video>
      <div class="hero__shade"></div>
    </div>

    <div class="hero__stages wrap">
      <div class="stage stage--1" data-stage data-in="-1" data-out="0.335">
        <p class="eyebrow">Offshore · Terrestre · México</p>
        <h1 id="hero-title" class="hero__title">
          <span class="ln">Mantenimiento</span>
          <span class="ln">y obras <span class="accent">offshore</span></span>
          <span class="ln">y terrestres.</span>
        </h1>
        <p class="hero__lead" id="resumen">
          Obra eléctrica, sistemas fotovoltaicos, aire acondicionado, aislamiento térmico, obra civil y
          estructural para la industria en México, en plataformas costa afuera y en tierra firme.
        </p>
        <div class="hero__actions">
          <a class="btn" href="#contacto">
            Cotizar proyecto
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"
              ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
            >
          </a>
          <a class="btn btn--ghost" href="#servicios">Ver especialidades</a>
        </div>
      </div>

      <div class="stage stage--2" data-stage data-in="0.347" data-out="0.653">
        <p class="eyebrow">Costa afuera</p>
        <p class="hero__claim">
          Fuerza, compromiso <br />y <span class="accent">experiencia</span> que <br />construye confianza.
        </p>
      </div>

      <div class="stage stage--3" data-stage data-in="0.665" data-out="2">
        <p class="eyebrow">Tierra firme</p>
        <p class="hero__claim">
          Del mar a tierra, <br /><span class="accent">un mismo estándar.</span>
        </p>
        <ul class="hero__chips" role="list">
          {services.map((s) => <li><a href={`#${s.id}`}>{s.name}</a></li>)}
        </ul>
        <div class="hero__actions">
          <a class="btn" href={whatsappUrl()} target="_blank" rel="noopener">
            Escribir por WhatsApp
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"
              ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
            >
          </a>
          <a class="btn btn--ghost" href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
        </div>
      </div>
    </div>

    <div class="hud" aria-hidden="true">
      <div class="hud__coords mono">
        <span class="hud__label">Posición</span>
        <span data-lat>19.4200° N</span>
        <span data-lng>92.0800° W</span>
      </div>
      <div class="hud__rail">
        <span class="mono">Offshore</span>
        <div class="hud__track"><i data-rail></i></div>
        <span class="mono">Terrestre</span>
      </div>
      <div class="hud__load mono" data-load><span data-load-pct>0</span>% secuencia</div>
    </div>

    <p class="chapter mono" aria-hidden="true" data-chapter>
      <span class="chapter__n" data-ch-n>01</span>
      <span class="chapter__sep"></span>
      <span data-ch-t>Plataforma offshore</span>
    </p>

    <div class="hero__cue mono" data-cue aria-hidden="true">
      <span>Desplázate</span>
      <i></i>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 420vh;
    height: 420svh;
    background: var(--navy-950);
  }
  .hero__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }
  .hero__media,
  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__video {
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }
  .hero.is-ready .hero__video {
    opacity: 1;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(6 14 32 / 0.88) 0%, rgb(6 14 32 / 0.55) 34%, rgb(6 14 32 / 0) 62%),
      linear-gradient(180deg, rgb(6 14 32 / 0.55) 0%, rgb(6 14 32 / 0) 22%, rgb(6 14 32 / 0) 70%, rgb(6 14 32 / 0.9) 100%);
  }

  .hero__stages {
    position: relative;
    height: 100%;
  }
  .stage {
    position: absolute;
    inset: 0 var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.75rem;
    max-width: 56rem;
    padding-top: 4.75rem;
    padding-bottom: 5.5rem;
    will-change: opacity, transform;
  }
  /* The first stage is top-anchored so late font swaps below the title never move it (CLS). */
  .stage--1 {
    justify-content: flex-start;
    padding-top: max(6.5rem, 23vh);
  }
  .stage--2,
  .stage--3 {
    opacity: 0;
    visibility: hidden;
  }
  .hero__title {
    font-size: min(clamp(2.25rem, 10.5vw, 7.25rem), 10.5vh);
    line-height: 0.94;
    font-weight: 300;
  }
  /* Fixed line breaks: the title height never depends on font metrics (no CLS on font swap). */
  .hero__title .ln {
    display: block;
    white-space: nowrap;
  }
  .hero__claim {
    font-size: min(var(--step-4), 9.5vh);
    line-height: 0.98;
    font-weight: 300;
    letter-spacing: -0.035em;
  }
  .hero__lead {
    max-width: 36rem;
    color: var(--fg-muted);
    font-size: clamp(1.05rem, 0.9rem + 0.5vw, 1.35rem);
    line-height: 1.45;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 40rem;
  }
  .hero__chips a {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--fg-muted);
    background: rgb(6 14 32 / 0.35);
    backdrop-filter: blur(6px);
    transition:
      color 0.3s,
      border-color 0.3s;
  }
  .hero__chips a:hover {
    color: var(--gold-400);
    border-color: var(--gold-500);
  }

  .hud {
    position: absolute;
    inset: auto var(--gutter) 2rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    pointer-events: none;
    color: var(--fg-dim);
  }
  .hud__coords {
    display: grid;
    gap: 0.2rem;
    font-variant-numeric: tabular-nums;
    color: var(--fg-muted);
  }
  .hud__label {
    color: var(--gold-400);
  }
  .hud__rail {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .hud__track {
    position: relative;
    width: clamp(8rem, 18vw, 16rem);
    height: 1px;
    background: var(--line-strong);
  }
  .hud__track i {
    position: absolute;
    inset: 0;
    background: var(--gold-400);
    transform-origin: left;
    transform: scaleX(var(--p, 0));
  }
  .hud__track i::after {
    content: '';
    position: absolute;
    right: -4px;
    top: -4px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--gold-400);
    box-shadow: 0 0 0 4px rgb(227 162 26 / 0.18);
  }
  .hud__load {
    position: absolute;
    right: 0;
    bottom: 2rem;
    transition: opacity 0.6s;
  }
  .hero.is-ready .hud__load {
    opacity: 0;
  }

  .chapter {
    position: absolute;
    left: 50%;
    bottom: 2.15rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    transform: translateX(-50%);
    white-space: nowrap;
    color: var(--paper);
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
    pointer-events: none;
  }
  .chapter.is-on {
    opacity: 1;
  }
  .chapter__n {
    color: var(--gold-400);
  }
  .chapter__sep {
    width: 1.5rem;
    height: 1px;
    background: var(--line-strong);
  }
  .chapter.is-swap [data-ch-t],
  .chapter.is-swap [data-ch-n] {
    display: inline-block;
    animation: chIn 0.7s var(--ease-out);
  }
  @keyframes chIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    transform: translateX(-50%);
    color: var(--fg-dim);
    transition: opacity 0.5s;
  }
  .hero__cue i {
    width: 1px;
    height: 2.75rem;
    background: linear-gradient(var(--gold-400), transparent);
    animation: cue 2.2s var(--ease-io) infinite;
    transform-origin: top;
  }
  @keyframes cue {
    0% {
      transform: scaleY(0);
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  @media (max-width: 900px) {
    .hero__cue {
      display: none;
    }
    .hud {
      bottom: 1.25rem;
    }
    .hud__load {
      display: none;
    }
    .chapter {
      bottom: 3.6rem;
    }
  }
  @media (max-aspect-ratio: 4/5) {
    .hero__shade {
      background:
        linear-gradient(180deg, rgb(6 14 32 / 0.7) 0%, rgb(6 14 32 / 0.1) 22%, rgb(6 14 32 / 0.72) 45%, rgb(6 14 32 / 0.92) 70%, rgb(6 14 32 / 0.97) 100%);
    }
    .stage {
      justify-content: flex-end;
      padding-bottom: 6.5rem;
      gap: 1.25rem;
    }
    .stage--1 {
      justify-content: flex-start;
      padding-top: max(6rem, calc(100svh - 35rem));
    }
    .hud__coords {
      display: none;
    }
    .hud {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: auto;
    }
    .hero__sticky {
      position: relative;
      min-height: 100svh;
    }
    .stage--2,
    .stage--3,
    .hud,
    .chapter,
    .hero__cue {
      display: none;
    }
    .stage--1 {
      position: relative;
      inset: auto;
      min-height: 100svh;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const video = hero.querySelector<HTMLVideoElement>('video')!;
  const stages = [...hero.querySelectorAll<HTMLElement>('[data-stage]')].map((el) => ({
    el,
    a: Number(el.dataset.in),
    b: Number(el.dataset.out),
  }));
  const rail = hero.querySelector<HTMLElement>('[data-rail]')!;
  const latEl = hero.querySelector<HTMLElement>('[data-lat]')!;
  const lngEl = hero.querySelector<HTMLElement>('[data-lng]')!;
  const cue = hero.querySelector<HTMLElement>('[data-cue]')!;
  const pctEl = hero.querySelector<HTMLElement>('[data-load-pct]')!;
  const chapter = hero.querySelector<HTMLElement>('[data-chapter]')!;
  const chNum = hero.querySelector<HTMLElement>('[data-ch-n]')!;
  const chText = hero.querySelector<HTMLElement>('[data-ch-t]')!;
  // Chapter boundaries match the stage hand-offs, so the HUD always names what is on screen.
  const CHAPTERS = [
    { until: 0.341, title: 'Plataforma offshore' },
    { until: 0.659, title: 'Golfo de México' },
    { until: Infinity, title: 'Tierra firme' },
  ];
  let chapterIdx = 0;

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
  const lite = !!conn?.saveData || /(^|-)2g$/.test(conn?.effectiveType ?? '');

  // Offshore (Sonda de Campeche) -> onshore (Ciudad del Carmen)
  const FROM = { lat: 19.42, lng: 92.08 };
  const TO = { lat: 18.6456, lng: 91.8295 };

  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const smooth = (t: number) => {
    const x = clamp(t);
    return x * x * (3 - 2 * x);
  };

  let duration = 0;
  let current = 0;
  let inView = true;

  const progress = () => {
    const r = hero.getBoundingClientRect();
    const total = r.height - window.innerHeight;
    return total > 0 ? clamp(-r.top / total) : 0;
  };

  const render = () => {
    const p = progress();
    const F = 0.035;
    for (const s of stages) {
      const fadeIn = s.a < 0 ? 1 : smooth((p - s.a) / F);
      const fadeOut = s.b > 1 ? 1 : smooth((s.b - p) / F);
      const alpha = Math.min(fadeIn, fadeOut);
      const dir = fadeIn < 1 ? 1 : -1;
      s.el.style.opacity = alpha.toFixed(3);
      s.el.style.transform = `translate3d(0, ${((1 - alpha) * 36 * dir).toFixed(1)}px, 0)`;
      s.el.style.visibility = alpha < 0.01 ? 'hidden' : 'visible';
      s.el.style.pointerEvents = alpha < 0.5 ? 'none' : 'auto';
    }
    rail.style.setProperty('--p', p.toFixed(4));
    latEl.textContent = `${(FROM.lat + (TO.lat - FROM.lat) * p).toFixed(4)}° N`;
    lngEl.textContent = `${(FROM.lng + (TO.lng - FROM.lng) * p).toFixed(4)}° W`;
    cue.style.opacity = p > 0.03 ? '0' : '1';
    chapter.classList.toggle('is-on', p > 0.03);
    const ci = CHAPTERS.findIndex((c) => p < c.until);
    if (ci !== chapterIdx) {
      chapterIdx = ci;
      chNum.textContent = `0${ci + 1}`;
      chText.textContent = CHAPTERS[ci].title;
      chapter.classList.remove('is-swap');
      void chapter.offsetWidth;
      chapter.classList.add('is-swap');
    }

    if (duration > 0) {
      const target = p * (duration - 0.05);
      current += (target - current) * 0.16;
      if (Math.abs(video.currentTime - current) > 0.01 && !video.seeking) {
        video.currentTime = current;
      }
    }
  };

  const loop = () => {
    if (inView) render();
    requestAnimationFrame(loop);
  };

  type Source = { w: number; src: string; type: string };

  // Best playable source: smallest tier that covers the needed device pixels, best codec first,
  // and only codecs the device decodes smoothly (seeking every frame needs hardware decode).
  const pickSource = async (): Promise<string> => {
    const sets = JSON.parse(video.dataset.sources!) as { wide: Source[]; tall: Source[] };
    const portrait = window.matchMedia('(max-aspect-ratio: 4/5)').matches;
    const list = portrait ? sets.tall : sets.wide;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const vw = window.innerWidth * dpr;
    const vh = window.innerHeight * dpr;
    const need = portrait ? Math.max(vw, (vh * 9) / 16) : Math.max(vw, (vh * 16) / 9);
    const tiers = [...new Set(list.map((s) => s.w))].sort((a, b) => a - b);
    const tier = tiers.find((t) => t >= need * 0.85) ?? tiers[tiers.length - 1];
    const ordered = [...list.filter((s) => s.w === tier), ...list.filter((s) => s.w !== tier)];
    for (const s of ordered) {
      if (!video.canPlayType(s.type)) continue;
      try {
        const info = await navigator.mediaCapabilities?.decodingInfo({
          type: 'file',
          video: {
            contentType: s.type,
            width: s.w,
            height: portrait ? Math.round((s.w * 16) / 9) : Math.round((s.w * 9) / 16),
            bitrate: 8_000_000,
            framerate: 24,
          },
        });
        if (info && !info.smooth) continue;
      } catch {
        /* mediaCapabilities unavailable: trust canPlayType */
      }
      return s.src;
    }
    return list[list.length - 1].src;
  };

  const loadVideo = async () => {
    const src = await pickSource();
    video.dataset.picked = src;
    let res: Response;
    try {
      res = await fetch(src);
    } catch {
      video.src = src; // Network hiccup: let the element stream it.
      res = new Response(null, { status: 204 });
    }
    if (!res.ok) return; // Missing file: keep the poster frame.
    if (res.status !== 204) {
      const total = Number(res.headers.get('content-length')) || 0;
      let blob: Blob;
      if (res.body && total) {
        const reader = res.body.getReader();
        const chunks: Uint8Array[] = [];
        let got = 0;
        for (;;) {
          const { done, value } = await reader.read();
          if (done) break;
          chunks.push(value);
          got += value.length;
          pctEl.textContent = String(Math.round((got / total) * 100));
        }
        blob = new Blob(chunks as BlobPart[], { type: 'video/mp4' });
      } else {
        blob = await res.blob();
      }
      video.src = URL.createObjectURL(blob);
    }
    video.addEventListener(
      'loadeddata',
      () => {
        duration = video.duration || 10;
        current = progress() * duration;
        video.currentTime = current;
        // iOS needs a play/pause gesture-less unlock before seeks paint frames.
        video
          .play()
          .then(() => video.pause())
          .catch(() => {});
        hero.classList.add('is-ready');
      },
      { once: true },
    );
    video.load();
  };

  if (!reduce) {
    new IntersectionObserver(([e]) => (inView = e.isIntersecting)).observe(hero);
    requestAnimationFrame(loop);
    if (!lite) {
      const start = () => loadVideo();
      if (document.readyState === 'complete') start();
      else window.addEventListener('load', start, { once: true });
    }
  }
</script>
