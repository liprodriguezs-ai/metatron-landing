---
import { site } from '../data/site';
import { buildSchema } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  path = '/',
  image = '/og/og-image.jpg',
  noindex = false,
} = Astro.props;

const canonical = new URL(path, site.url).href;

// Share previews (WhatsApp, Facebook, LinkedIn, X) must fetch real, reachable URLs. The production
// build uses the configured domain; in dev (e.g. behind a Cloudflare tunnel) use the requesting host
// so link previews work before the domain is live.
// (Astro strips request headers on prerendered pages, so the host comes from Astro.url; tunnels serve HTTPS.)
const shareBase = (() => {
  if (!import.meta.env.DEV) return site.url;
  const { host, hostname } = Astro.url;
  const local = hostname === 'localhost' || hostname === '127.0.0.1';
  return `${local ? 'http' : 'https'}://${host}`;
})();
const shareUrl = new URL(path, shareBase).href;
const ogImage = new URL(image, shareBase).href;
const ogSquare = new URL('/og/og-square.jpg', shareBase).href;
const schema = JSON.stringify(buildSchema()).replace(/</g, '\\u003c');
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta
  name="robots"
  content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>
<link rel="alternate" hreflang="es-MX" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="text/markdown" title="LLM summary" href="/llms.txt" />

<meta name="author" content={site.name} />
<meta name="application-name" content={site.name} />
<meta name="format-detection" content="telephone=yes" />

<!-- Local / GEO (country only; the office location is not published) -->
<meta name="geo.region" content={site.country} />
<meta name="geo.placename" content="México" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:url" content={shareUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Metatron Service — mantenimiento y obras offshore y terrestres en México" />
<meta property="og:image" content={ogSquare} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="1200" />
<meta property="business:contact_data:country_name" content="México" />
<meta property="business:contact_data:email" content={site.email} />
<meta property="business:contact_data:phone_number" content={site.phone} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content="Metatron Service — mantenimiento y obras offshore y terrestres" />

<script type="application/ld+json" set:html={schema} />
