---
import { otherSpecialties, services } from '../data/site';

const ticker = [...services.map((s) => s.name), ...otherSpecialties];
const manifesto =
  'Una buena planeación, el material adecuado, menor tiempo de ejecución y un costo competitivo. Así mantenemos operando la infraestructura que mueve a la industria del Golfo.';
const words = manifesto.split(' ');
const highlight = new Set(['planeación,', 'adecuado,', 'ejecución', 'competitivo.']);

const figures = [
  { n: '06', label: 'Especialidades técnicas', text: 'Eléctrica, fotovoltaica, A/A, aislamiento, civil y estructural.' },
  { n: '02', label: 'Frentes de trabajo', text: 'Instalaciones offshore y terrestres con el mismo rigor.' },
  { n: '01', label: 'Estándar', text: 'Calidad, seguridad y compromiso en cada etapa del proyecto.' },
];
---

<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    {
      [0, 1].map(() => (
        <ul role="list">
          {ticker.map((t) => (
            <li>
              <span>{t}</span>
              <svg viewBox="0 0 10 10">
                <path d="M5 0 6.2 3.8 10 5 6.2 6.2 5 10 3.8 6.2 0 5 3.8 3.8Z" fill="currentColor" />
              </svg>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<section class="intro section" aria-labelledby="intro-title">
  <div class="wrap">
    <h2 id="intro-title" class="eyebrow" data-reveal>Nuestra forma de trabajar</h2>
    <p class="manifesto" data-manifesto>
      {
        words.map((w) => (
          <>
            <span class:list={['w', { 'w--hi': highlight.has(w) }]}>{w}</span>{' '}
          </>
        ))
      }
    </p>

    <ul class="figures" role="list">
      {
        figures.map((f, i) => (
          <li data-reveal style={`--d:${i * 0.12}s`}>
            <span class="figures__n">{f.n}</span>
            <span class="mono figures__label">{f.label}</span>
            <p>{f.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ticker {
    position: relative;
    z-index: 2;
    overflow: hidden;
    border-block: 1px solid var(--line);
    background: var(--navy-950);
    padding-block: 1.4rem;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .ticker__track {
    display: flex;
    width: max-content;
    animation: ticker 60s linear infinite;
  }
  .ticker ul {
    display: flex;
  }
  .ticker li {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    padding-right: 2.5rem;
    font-size: clamp(1.25rem, 2.4vw, 2rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--fg-muted);
  }
  .ticker svg {
    width: 0.7rem;
    color: var(--gold-500);
  }
  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }

  .intro .wrap {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }
  .manifesto {
    font-size: var(--step-3);
    line-height: 1.12;
    font-weight: 300;
    letter-spacing: -0.03em;
    max-width: 22em;
  }
  .w {
    opacity: var(--o, 0.5);
    transition: opacity 0.25s linear;
  }
  .w--hi {
    color: var(--gold-400);
    font-weight: 500;
  }

  .figures {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: clamp(2rem, 6vw, 5rem);
    border-top: 1px solid var(--line);
  }
  .figures li {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    padding: 2rem 2rem 0 0;
  }
  .figures li + li {
    padding-left: 2rem;
    border-left: 1px solid var(--line);
  }
  .figures__n {
    font-size: var(--step-5);
    font-weight: 300;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--gold-400);
    font-variant-numeric: tabular-nums;
  }
  .figures__label {
    color: var(--paper);
  }
  .figures p {
    color: var(--fg-muted);
    max-width: 22rem;
  }
  @media (max-width: 760px) {
    .figures {
      grid-template-columns: 1fr;
    }
    .figures li,
    .figures li + li {
      padding: 1.75rem 0;
      border-left: 0;
      border-bottom: 1px solid var(--line);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker__track {
      animation: none;
    }
    .w {
      opacity: 1;
    }
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-manifesto]');
  if (el && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words = [...el.querySelectorAll<HTMLElement>('.w')];
    let active = false;
    new IntersectionObserver(([e]) => (active = e.isIntersecting)).observe(el);
    const tick = () => {
      if (active) {
        const r = el.getBoundingClientRect();
        const vh = window.innerHeight;
        const p = Math.min(1, Math.max(0, (vh * 0.85 - r.top) / (r.height + vh * 0.35)));
        const lit = p * words.length;
        words.forEach((w, i) => w.style.setProperty('--o', String(Math.min(1, Math.max(0.5, lit - i)))));
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>
