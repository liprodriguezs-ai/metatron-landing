---
import Base from '../layouts/Base.astro';
import Icon from '../assets/brand/logo-icon-currentcolor.svg';
---

<Base title="Página no encontrada | Metatron Service" path="/404" noindex>
  <main class="nf" id="contenido">
    <Icon class="nf__icon" aria-hidden="true" />
    <p class="eyebrow">Error 404</p>
    <h1>Esta ruta <span class="accent">no está en el plano.</span></h1>
    <a class="btn" href="/">Volver al inicio</a>
  </main>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.75rem;
    padding: var(--gutter);
    text-align: center;
  }
  .nf__icon {
    width: 7rem;
    height: auto;
    color: var(--gold-400);
  }
  .nf h1 {
    font-size: var(--step-4);
    max-width: 14em;
  }
</style>
